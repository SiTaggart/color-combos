{
  "name": "color-combos",
  "version": "1.1.0",
  "description": "Get accessibility information about colour combinations",
  "keywords": [
    "a11y",
    "accessibility",
    "color",
    "contrast",
    "esm",
    "typescript",
    "wcag"
  ],
  "homepage": "https://github.com/SiTaggart/color-combos#readme",
  "bugs": {
    "url": "https://github.com/SiTaggart/color-combos/issues"
  },
  "license": "MIT",
  "author": "sitaggart",
  "repository": {
    "type": "git",
    "url": "https://github.com/SiTaggart/color-combos.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "bun run clean && bun run compile",
    "build:dev": "bun run clean && bun run compile:dev",
    "clean": "rm -rf ./dist",
    "compile": "NODE_ENV=production bun run build.ts",
    "compile:dev": "NODE_ENV=development bun run build.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "test": "bun test src",
    "test:integration": "bun test _test_/integration",
    "test:all": "bun run test && bun run build && bun run test:integration",
    "semantic-release": "semantic-release",
    "size": "bun run build && size-limit",
    "prepare": "husky"
  },
  "dependencies": {
    "apca-w3": "0.1.9",
    "color": "5.0.3",
    "lodash.uniq": "4.5.0"
  },
  "devDependencies": {
    "@size-limit/preset-big-lib": "12.1.0",
    "@types/apca-w3": "0.1.3",
    "@types/bun": "1.3.14",
    "@types/color": "4.2.1",
    "@types/lodash": "4.17.24",
    "@types/lodash.uniq": "4.5.9",
    "@types/node": "25.9.1",
    "husky": "9.1.7",
    "oxc-transform": "0.132.0",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "precise-commits": "1.0.2",
    "semantic-release": "25.0.3",
    "size-limit": "12.1.0"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "size-limit": [
    {
      "path": "dist/*.js",
      "limit": "14 kB"
    },
    {
      "path": "dist/*.mjs",
      "limit": "14 kB",
      "import": "ColorCombos"
    }
  ],
  "engines": {
    "bun": ">=1.0.0",
    "node": "24.16.0"
  },
  "entry": "src/index.ts"
}
